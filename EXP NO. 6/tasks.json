{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Spring Boot: Run App",
            "type": "shell",
            "command": "${workspaceFolder}\\mvnw.cmd spring-boot:run",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}\\mvnw.cmd test",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Package Jar",
            "type": "shell",
            "command": "${workspaceFolder}\\mvnw.cmd clean package -DskipTests",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
